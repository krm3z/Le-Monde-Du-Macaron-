---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Val from '../components/Val.astro';
import Filet from '../components/Filet.astro';
import { boutique, produits, photo, nbProduits } from '../lib/site.js';

const filtres = [
  { id: 'tout', label: 'Tout', n: produits.length },
  { id: 'sucré', label: 'Sucré', n: nbProduits('sucré') },
  { id: 'salé', label: 'Salé', n: nbProduits('salé') },
  { id: 'coffret', label: 'Coffrets', n: nbProduits('coffret') },
  { id: 'autre', label: 'Calissons', n: nbProduits('autre') },
  { id: 'salon', label: 'Salon de thé', n: nbProduits('salon') },
].filter((f) => f.n > 0);
const famille = { 'sucré': 'Macaron sucré', 'salé': 'Macaron salé', coffret: 'Coffret', autre: 'Calisson', salon: 'Salon de thé · sur place' };
---
<Base
  page="macarons"
  title="Nos macarons sucrés et salés"
  description={`${nbProduits('sucré')} macarons sucrés, ${nbProduits('salé')} macarons salés et ${nbProduits('autre')} calissons au Monde du Macaron Villefranche : parfums, descriptions et allergènes.`}
>
  <header class="entete jour cadre">
    <h1>Nos macarons</h1>
    <Filet />
    <p class="texte" data-reveal="fondu">{boutique.textes.intro_macarons}</p>
  </header>

  <section class="cadre" style="padding-bottom:clamp(4rem,10vw,8rem)" aria-label="Liste des produits">
    <div class="filtres" role="group" aria-label="Filtrer les produits" data-filtres>
      {filtres.map((f, i) => (
        <button type="button" data-filtre={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}<sup>{f.n}</sup></button>
      ))}
      <span class="filtres__trait" aria-hidden="true" data-trait></span>
    </div>
    <p class="compte meta"><span aria-hidden="true" data-compte>{produits.length}</span><span aria-hidden="true"> produits</span><span class="sr-only" aria-live="polite" data-annonce>{produits.length} produits affichés</span></p>

    <ul class="nuancier" role="list" data-nuancier>
      {produits.map((p) => {
        const d = p.famille === 'macaron' ? photo(`detoure/${p.photo}`)?.sizes[0] : null;
        return (
          <li class:list={['fiche', { 'fiche--sale': p.categorie === 'salé', 'fiche--calisson': p.famille === 'calisson', 'fiche--salon': p.famille === 'salon' }]} id={p.id} data-cat={p.categorie}>
            <button class="fiche__btn" type="button" aria-pressed="false" data-fiche>
              <span class="fiche__face fiche__recto">
                <span class="fiche__objet">
                  {d ? <img src={d.src} width={d.w} height={d.h} alt={`Macaron ${p.nom}`} loading="lazy" decoding="async" />
                    : p.photo ? <Img name={p.photo} alt={p.nom} sizes="300px" />
                    : <span class="photo-a-venir">Photo à venir</span>}
                </span>
                <span>
                  <span class="fiche__nom">{p.nom}</span>
                  <span class="fiche__famille meta">{famille[p.categorie]}</span>
                  <span class="fiche__dos">Allergènes au dos</span>
                  {p.photo_illustration && <span class="fiche__famille meta">Photo d’illustration</span>}
                </span>
              </span>
              <span class="fiche__face fiche__verso" aria-hidden="true">
                <span>
                  <span class="t">{p.nom}</span>
                  <span style="display:block;margin-bottom:1em">{p.description}</span>
                  <span class="l">Allergènes</span>
                  <span><Val v={p.allergenes} /></span>
                </span>
                <span>
                  {p.prix && <span class="t">{p.prix}</span>}
                  <small>Un doute ? Demandez conseil en boutique.</small>
                </span>
              </span>
            </button>
          </li>
        );
      })}
    </ul>
    <p class="aussi legende">{boutique.textes.aussi_en_boutique}</p>
  </section>
</Base>
