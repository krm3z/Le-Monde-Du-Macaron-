---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Filet from '../components/Filet.astro';
import { boutique, produits, telHref, mailHref, isTodo } from '../lib/site.js';
const mots = boutique.textes.intro_coffrets.split(' ');
const mailManquant = isTodo(boutique.email);
const nomPhoto = (ph) => produits.find((p) => p.photo === ph)?.nom ?? '';
---
<Base
  page="coffrets"
  title="Coffrets & événements : conscrits, mariages, entreprises"
  description="Coffrets de macarons pour les conscrits, les mariages et les entreprises au Monde du Macaron Villefranche. Appelez ou écrivez à la boutique pour composer votre commande."
>
  <div class="ruban" aria-hidden="true" data-ruban></div>
  <header class="entete jour cadre">
    <h1>Coffrets <em>&amp;</em> événements</h1>
    <Filet />
    <p class="remplir" data-remplir>{mots.map((m) => <><span class="w">{m}</span>{' '}</>)}</p>
  </header>

  <div class="nuit">
    {boutique.evenements.map((e) => (
      <section class="cadre chapitre" id={e.id} aria-labelledby={`ev-${e.id}`}>
        <div>
          <h2 id={`ev-${e.id}`} data-reveal="lignes">{e.titre}</h2>
          <p class="legende">{e.sous_titre}</p>
          <p class="texte" data-reveal="fondu">{e.texte}</p>
          <div class="btns" style="margin-top:1.6rem">
            <a class="btn btn--fuchsia" href={telHref}>Appeler</a>
            <a class="btn" href={mailHref(e.objet_mail)}>Envoyer un mail</a>
          </div>
          {mailManquant && <p class="meta" style="margin-top:.9rem"><mark class="todo">[À REMPLACER]</mark> adresse e-mail de la boutique</p>}
        </div>
        <div class="glisse" aria-hidden="true">
          <div class="triptyque" data-glisse>
            {e.photos.map((ph) => <div class="triptyque__img"><Img name={ph} alt={`Macarons ${nomPhoto(ph)}`} sizes="(min-width: 1000px) 26vw, 60vw" /></div>)}
          </div>
        </div>
      </section>
    ))}
  </div>

  <section class="section jour cadre" aria-labelledby="titre-commander">
    <h2 class="h2" id="titre-commander" data-reveal="lignes">Pour commander</h2>
    <p class="texte" style="margin:1.2rem 0 1.6rem" data-reveal="fondu">Les coffrets se préparent avec la boutique : appelez-nous ou écrivez-nous en indiquant la date, le nombre de personnes et vos envies.</p>
    <div class="btns">
      <a class="btn btn--fuchsia" href={telHref}>Appeler le {boutique.telephone}</a>
      <a class="btn" href={mailHref()}>Envoyer un mail</a>
    </div>
  </section>
</Base>
