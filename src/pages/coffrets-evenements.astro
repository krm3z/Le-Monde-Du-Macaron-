---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import { boutique, produits, telHref, mailHref, isTodo } from '../lib/site.js';

const avecPhoto = produits.filter((p) => p.famille === 'macaron' && p.photo);
const rang1 = avecPhoto.filter((_, i) => i % 7 === 1).slice(0, 8);
const rang2 = avecPhoto.filter((_, i) => i % 7 === 4).slice(0, 8);
const mots = boutique.textes.intro_coffrets.split(' ');
const mailManquant = isTodo(boutique.email);
---
<Base
  page="coffrets"
  title="Coffrets & événements : conscrits, mariages, entreprises"
  description="Coffrets de macarons pour les conscrits, les mariages et les entreprises à Villefranche-sur-Saône. Appelez ou écrivez-nous pour composer votre commande."
>
  <header class="page-head wrap">
    <p class="eyebrow" data-reveal>Sur mesure</p>
    <h1 class="h-display" data-reveal>Coffrets <em>&amp; événements</em></h1>
  </header>

  <section class="wrap" aria-label="Présentation">
    <p class="fill-text" data-fill>
      {mots.map((m) => <><span class="w">{m}</span>{' '}</>)}
    </p>
  </section>

  <div class="slides section" aria-hidden="true" style="padding-block:clamp(3rem,8vw,6rem)">
    <div class="slides__row" data-slide="-1">
      {rang1.map((p) => <div class="slides__img"><Img name={p.photo} alt="" sizes="(min-width: 900px) 28vw, 50vw" /></div>)}
    </div>
    <div class="slides__row" data-slide="1" style="margin-left:-30%">
      {rang2.map((p) => <div class="slides__img"><Img name={p.photo} alt="" sizes="(min-width: 900px) 28vw, 50vw" /></div>)}
    </div>
  </div>

  <div class="wrap" style="padding-bottom:clamp(4rem,10vw,8rem)">
    {boutique.evenements.map((e, i) => (
      <section class="ev" id={e.id} aria-labelledby={`ev-${e.id}`}>
        <div data-reveal>
          <span class="ev__num">0{i + 1}</span>
          <h2 id={`ev-${e.id}`}>{e.titre}</h2>
          <p class="ev__sub">{e.sous_titre}</p>
          <p class="lead">{e.texte}</p>
          <div class="btns">
            <a class="btn" href={telHref}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
              Appeler
            </a>
            <a class="btn btn--ghost" href={mailHref(e.objet_mail)}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
              Envoyer un mail
            </a>
          </div>
          {mailManquant && <p style="margin-top:.8rem;font-size:.85rem"><mark class="todo">[À REMPLACER]</mark> adresse e-mail de la boutique</p>}
        </div>
        <div class="ev__photos" data-reveal>
          {e.photos.map((ph) => <div><Img name={ph} alt={`Macarons ${produits.find((p) => p.photo === ph)?.nom ?? ''}`} sizes="(min-width: 900px) 15vw, 30vw" /></div>)}
        </div>
      </section>
    ))}
  </div>
</Base>
