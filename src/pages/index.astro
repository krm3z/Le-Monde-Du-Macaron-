---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Horaires from '../components/Horaires.astro';
import { boutique, produits, photo, telHref, noteFr, adresseLigne, horairesGroupes } from '../lib/site.js';

// Macarons détourés de la vitrine d'accueil (ordre d'arrivée)
const vitrine = ['framboise', 'pistache', 'citron', 'myrtille', 'chocolat', 'mangue-passion', 'violette', 'vanille']
  .map((id) => ({ id, p: photo(`detoure/macaron-${id}-seul`)?.sizes[0], nom: produits.find((x) => x.id === id)?.nom }))
  .filter((m) => m.p);

const selection = produits.filter((p) => p.mis_en_avant && p.photo).slice(0, 8);
const bandeau = produits.filter((p) => p.famille === 'macaron' && p.photo).filter((_, i) => i % 6 === 0).slice(0, 10);
const semaine = horairesGroupes().find((g) => !g.plage.startsWith('Fermé'));
const mark = (t) => t.replace('[À REMPLACER]', '<mark class="todo">[À REMPLACER]</mark>');
const g = boutique.google;
---
<Base
  page="accueil"
  title={`${boutique.nom} Villefranche-sur-Saône · Macarons, coffrets et salon de thé`}
  description={`Macarons sucrés et salés, calissons et coffrets pour conscrits, mariages et entreprises. ${adresseLigne}. ${boutique.telephone}.`}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__grid">
      <figure class="hero__vitrine" aria-label="Quelques macarons de la vitrine">
        {vitrine.map((m, i) => (
          <div class="hero__mac" data-hero-mac>
            <img src={m.p.src} width={m.p.w} height={m.p.h} alt={`Macaron ${m.nom}`} fetchpriority={i < 4 ? 'high' : undefined} decoding="async" />
          </div>
        ))}
        <figcaption data-hero-fade>{vitrine.map((m) => m.nom).slice(0, 4).join(', ')}…</figcaption>
      </figure>
      <div>
        <p class="eyebrow">Boutique et salon de thé · <span style="white-space:nowrap">Villefranche-sur-Saône</span></p>
        <h1 class="hero__title" id="hero-title" data-hero-fade>{boutique.nom}</h1>
        <p class="hero__lead">{boutique.textes.accroche}</p>
        <ul class="facts">
          {semaine && <li><span>{semaine.jours}</span><span set:html={mark(semaine.plage)} /></li>}
          <li><span>Adresse</span><span>{boutique.adresse.rue}</span></li>
          <li><span>Téléphone</span><span><a href={telHref}>{boutique.telephone}</a></span></li>
        </ul>
        <div class="btns">
          <a class="btn" href="/nos-macarons/">Voir les macarons</a>
          <a class="btn btn--ghost" href={g.lien_itineraire} rel="noopener" target="_blank">Itinéraire<span class="sr-only"> (nouvel onglet)</span></a>
        </div>
        <p class="hero__note">Noté {noteFr(g.note)}/5 sur Google ({g.nombre_avis} avis). <a href={g.lien_fiche} rel="noopener" target="_blank">Voir les avis<span class="sr-only"> (nouvel onglet)</span></a></p>
      </div>
    </div>
  </section>

  <div class="marquee" data-marquee aria-label="Quelques parfums">
    <div class="marquee__track">
      {[0, 1].map((k) => (
        <div class="marquee__group" aria-hidden={k === 1 ? 'true' : undefined}>
          {bandeau.map((p) => (
            <span class="marquee__item">
              <Img name={p.photo} alt={k ? '' : `Macaron ${p.nom}`} sizes="64px" />
              {p.nom}
              <span class="marquee__dot" aria-hidden="true"></span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <section class="section" aria-labelledby="sel-title">
    <div class="wrap">
      <div class="head-row">
        <div>
          <h2 class="h-section" id="sel-title">Quelques parfums</h2>
          <p class="lead">{boutique.textes.intro_accueil}</p>
        </div>
        <a class="link-arrow" href="/nos-macarons/">Toute la carte</a>
      </div>
      <div class="selection">
        {selection.map((p) => (
          <a class="pick" href={`/nos-macarons/#${p.id}`} data-reveal>
            <div class="pick__img"><Img name={p.photo} alt={`Macarons ${p.nom}`} sizes="(min-width: 900px) 25vw, 45vw" /></div>
            <span class="pick__name">{p.nom}<small>{p.categorie}</small></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="coffrets-title">
    <div class="wrap split">
      <div>
        <h2 class="h-section" id="coffrets-title">Coffrets et commandes</h2>
        <p class="lead" style="margin-top:1rem">{boutique.textes.intro_coffrets}</p>
        <a class="link-arrow" href="/coffrets-evenements/">Coffrets et événements</a>
      </div>
      <div class="events">
        {boutique.evenements.map((e) => (
          <a class="event-card" href={`/coffrets-evenements/#${e.id}`}>
            <div><h3>{e.titre}</h3><p>{e.sous_titre}</p></div>
            <div class="event-card__img"><Img name={e.photos[0]} alt="" sizes="72px" /></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="visit-title">
    <div class="wrap">
      <div class="visit">
        <div>
          <p class="eyebrow">Venir à la boutique</p>
          <h2 class="h-section" id="visit-title">Au centre de Villefranche, rue Nationale</h2>
          <address>{boutique.adresse.rue}<br />{boutique.adresse.code_postal} {boutique.adresse.ville}</address>
          <div class="btns">
            <a class="btn" href={g.lien_itineraire} rel="noopener" target="_blank">Itinéraire<span class="sr-only"> (nouvel onglet)</span></a>
            <a class="btn btn--ghost" href={telHref}>Appeler le {boutique.telephone}</a>
          </div>
        </div>
        <Horaires />
      </div>
    </div>
  </section>
</Base>
