---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Filet from '../components/Filet.astro';
import AvisGoogle from '../components/AvisGoogle.astro';
import { boutique, produits, photo, telHref, noteFr, adresseLigne, horairesGroupes, nbProduits } from '../lib/site.js';

// La pile de la vitrine (du bas vers le haut) : macarons détourés « seuls »
const pile = ['chocolat', 'pistache', 'framboise', 'citron', 'myrtille', 'vanille', 'mangue-passion', 'violette']
  .map((id) => ({ id, p: photo(`detoure/macaron-${id}-seul`)?.sizes[0], nom: produits.find((x) => x.id === id)?.nom }))
  .filter((m) => m.p);
const decal = [0, 3, -2, 4, -3, 2, -4, 1];

// Bandeau : macarons détourés (sucrés et salés mélangés)
const macs = produits.filter((p) => p.famille === 'macaron' && photo(`detoure/${p.photo}`));
const bandeau = macs.filter((_, i) => i % 6 === 2).slice(0, 12);
const sucres = produits.filter((p) => p.categorie === 'sucré');
const sales = produits.filter((p) => p.categorie === 'salé');
// Mur de macarons rangé par couleur : teintes vives en dégradé (rose → rouge → orange → jaune → vert → bleu → violet), puis crèmes et chocolats
import couleurs from '../generated/couleurs.json';
const cle = (p) => {
  const c = couleurs[p.id];
  if (!c) return 9999;
  if (!c.colore) return 1000 + (1 - c.l) * 100; // crèmes puis chocolats
  return (c.h + 30) % 360; // roses, rouges, oranges, jaunes, verts, bleus, violets
};
const mur = [...sucres, ...sales].sort((a, b) => cle(a) - cle(b));
const nbMacarons = sucres.length + sales.length;
const semaine = horairesGroupes().find((g) => !g.plage.startsWith('Fermé'));
const [hOuv, hFerm] = semaine ? semaine.plage.split(' – ') : ['', ''];
const g = boutique.google;
const s = boutique.salon_de_the;
const motsNom = [['Le', 'Monde'], ['du'], ['Macaron'], ['Villefranche']];
---
<Base
  page="accueil"
  title={`${boutique.nom_complet} · Macarons, coffrets et salon de thé rue Nationale`}
  description={`${boutique.nom_complet} : macarons sucrés et salés, calissons, coffrets pour conscrits, mariages et entreprises, salon de thé. ${adresseLigne}. ${boutique.telephone}.`}
>
  <section class="vitrine nuit" aria-labelledby="titre-vitrine" data-vitrine>
    <div class="cadre vitrine__grille">
      <figure class="pile pile__reflet" role="img" aria-label={`Pile de macarons : ${pile.map((m) => m.nom).join(', ')}`} data-pile>
        {pile.map((m, i) => (
          <div class="pile__mac" style={`--delai:calc(.2s + ${i} * .11s);--dx:${decal[i]}px`}>
            <img src={m.p.src} width={m.p.w} height={m.p.h} alt="" fetchpriority={i < 3 ? 'high' : undefined} decoding="async" />
          </div>
        ))}
      </figure>
      <div class="vitrine__titre">
        <h1 class="vitrine__nom" id="titre-vitrine" aria-label={boutique.nom_complet}>
          <span aria-hidden="true">
            <span class="mot"><span style="--i:0">Le</span></span> <span class="mot"><span style="--i:1">Monde</span></span><br />
            <span class="mot du"><span style="--i:2">du</span></span> <span class="mot"><span style="--i:3">Macaron</span></span><br />
            <span class="mot ville"><span style="--i:4">Villefranche</span></span>
          </span>
        </h1>
      </div>
      <div class="etagere" style="animation-delay:0s" aria-hidden="true"></div>
      <div class="vitrine__bas">
        <div>
          <p class="chapeau" style="color:var(--blanc)">{boutique.textes.accroche}</p>
          <p class="infos">
            <span class="statut" data-statut={JSON.stringify(boutique.horaires)}>{semaine?.jours} · {semaine?.plage}</span>
            <span>{boutique.adresse.rue}</span>
            <a href={telHref}><strong>{boutique.telephone}</strong></a>
          </p>
        </div>
        <div class="btns" style="align-self:end">
          <a class="btn btn--fuchsia" href={telHref}>Appeler</a>
          <a class="btn" href={g.lien_itineraire} rel="noopener" target="_blank">Itinéraire<span class="sr-only"> (nouvel onglet)</span></a>
          <a class="btn" href="/nos-macarons/">Voir les macarons <span class="fleche" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="bandeau jour" aria-label="Quelques parfums" data-bandeau>
    <div class="bandeau__piste">
      {[0, 1].map((k) => (
        <div class="bandeau__groupe" aria-hidden={k === 1 ? 'true' : undefined}>
          {bandeau.map((p) => {
            const d = photo(`detoure/${p.photo}`).sizes[0];
            return (
              <span class:list={['bandeau__item', { sale: p.categorie === 'salé' }]}>
                <img src={d.src} width={d.w} height={d.h} alt="" loading="lazy" decoding="async" />
                {p.nom}
                <span class="losange" aria-hidden="true"></span>
              </span>
            );
          })}
        </div>
      ))}
    </div>
    <button class="bandeau__pause" type="button" data-pause aria-pressed="false">Mettre en pause</button>
  </section>

  <section class="section jour" aria-labelledby="titre-parfums">
    <div class="cadre">
      <div class="parfums__haut">
        <span class="mega" data-reveal="chiffres" aria-hidden="true">{String(nbMacarons).split('').map((c) => <span class="masque"><span class="c">{c}</span></span>)}</span>
        <div>
          <h2 class="h2" id="titre-parfums" data-reveal="lignes">{nbMacarons} parfums à la carte</h2>
          <p class="legende" style="margin-top:1rem">{nbProduits('sucré')} sucrés, {nbProduits('salé')} salés, et {nbProduits('autre')} calissons. {boutique.textes.intro_accueil}</p>
        </div>
      </div>
      <div class="mur__onglets" role="group" aria-label="Afficher" data-mur-onglets>
        <button type="button" aria-pressed="true" data-mur-filtre="tout">Tous <sup>{nbMacarons}</sup></button>
        <button type="button" aria-pressed="false" data-mur-filtre="sucré">Sucrés <sup>{sucres.length}</sup></button>
        <button type="button" aria-pressed="false" data-mur-filtre="salé">Salés <sup>{sales.length}</sup></button>
      </div>
      <ul class="mur" role="list" data-mur>
        {mur.map((p, i) => {
          const d = photo(`detoure/${p.photo}`)?.sizes[0];
          return (
            <li class:list={['mur__item', { 'mur__item--sale': p.categorie === 'salé', 'mur__item--plus': i >= 16 }]} data-cat={p.categorie} style={`--teinte:${couleurs[p.id]?.hex ?? '#ccc'}`}>
              <a href={`/nos-macarons/#${p.id}`}>
                {d ? <img src={d.src} width={d.w} height={d.h} alt="" loading="lazy" decoding="async" /> : <span class="photo-a-venir">Photo à venir</span>}
                <span class="mur__nom">{p.nom}</span>
              </a>
            </li>
          );
        })}
      </ul>
      <button class="btn mur__plus" type="button" aria-expanded="false" data-mur-plus>Voir les {nbMacarons} parfums</button>
    </div>
  </section>

  <AvisGoogle />

  <section class="section jour salon" aria-labelledby="titre-salon" style="padding-top:0">
    <div class="cadre">
      <Filet />
      <h2 class="h2" id="titre-salon" style="margin-top:2.5rem" data-reveal="lignes">{s.titre}</h2>
      <ul class="salon__carte" data-reveal="pose">
        {s.carte.map((c) => <li>{c}</li>)}
      </ul>
      <div class="salon__photos">
        {produits.filter((p) => p.famille === 'salon' && p.photo).map((p) => (
          <a class="salon__photo" href={`/nos-macarons/?filtre=salon#${p.id}`}>
            <span class="salon__img" data-reveal="image"><Img name={p.photo} alt={p.nom} sizes="(min-width: 900px) 22vw, 60vw" /></span>
            <span class="legende">{p.nom}</span>
          </a>
        ))}
      </div>
      <p class="meta" style="margin-bottom:1.5rem">Photos d’illustration, en attendant les photos de la boutique.</p>
      <p class="texte" data-reveal="fondu">{s.texte}</p>
      <a class="lien" href="/la-boutique/">Voir la boutique et ses horaires</a>
    </div>
  </section>

  <section class="section nuit" aria-labelledby="titre-evts">
    <div class="cadre">
      <h2 class="h2" id="titre-evts" style="color:var(--blanc)" data-reveal="lignes">Coffrets et commandes</h2>
      <p class="texte" style="margin-top:1.2rem" data-reveal="fondu">{boutique.textes.intro_coffrets}</p>
      <div class="evts">
        {boutique.evenements.map((e) => (
          <a class="evt" href={`/coffrets-evenements/#${e.id}`}>
            <div class="evt__img" data-reveal="image"><Img name={e.photos[0]} alt="" sizes="(min-width: 800px) 30vw, 90vw" /></div>
            <h3 class="h3" style="color:var(--blanc)">{e.titre}</h3>
            <span class="legende">{e.sous_titre}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section jour" aria-labelledby="titre-venir">
    <div class="cadre venir">
      <div>
        <h2 class="sr-only" id="titre-venir">Venir à la boutique</h2>
        <p class="mega venir__heures" data-reveal="fondu">
          <span class="sr-only">{semaine?.jours} de {hOuv} à {hFerm}</span>
          <span aria-hidden="true">{hOuv}</span><Filet /><span aria-hidden="true">{hFerm}</span>
        </p>
        <p class="legende" style="margin-top:1rem">{semaine?.jours?.toLowerCase()}, dimanche fermé</p>
      </div>
      <div data-reveal="fondu">
        <address class="chapeau" style="margin-bottom:1.4rem">{boutique.adresse.rue}<br />{boutique.adresse.code_postal} {boutique.adresse.ville}</address>
        <div class="btns">
          <a class="btn btn--fuchsia" href={g.lien_itineraire} rel="noopener" target="_blank">Itinéraire<span class="sr-only"> (nouvel onglet)</span></a>
          <a class="btn" href={telHref}>Appeler</a>
        </div>
        <p class="meta" style="margin-top:1.4rem">{noteFr(g.note)}/5 · {g.nombre_avis} avis Google · <a class="lien" href={g.lien_fiche} rel="noopener" target="_blank">voir les avis<span class="sr-only"> (nouvel onglet)</span></a></p>
      </div>
    </div>
  </section>
</Base>
