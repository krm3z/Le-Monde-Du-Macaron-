---
import Horaires from './Horaires.astro';
import { boutique, telHref } from '../lib/site.js';
const a = boutique.adresse;
---
<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <p class="footer__title"><img src="/logo-monde-du-macaron.webp" width="500" height="116" alt="Le Monde du Macaron" loading="lazy" /><span>Villefranche</span></p>
      <p class="footer__slogan">{boutique.slogan}</p>
      <a class="footer__tel" href={telHref}>{boutique.telephone}</a>
    </div>
    <div>
      <h2 class="footer__h">Adresse</h2>
      <address>{a.rue}<br />{a.code_postal} {a.ville}</address>
      <p><a href={telHref}>{boutique.telephone}</a></p>
    </div>
    <div>
      <h2 class="footer__h">Horaires</h2>
      <Horaires groupes class="horaires--footer" />
    </div>
    <div>
      <h2 class="footer__h">Suivez-nous</h2>
      <ul class="footer__social">
        <li><a href={boutique.reseaux.instagram} rel="noopener" target="_blank">Instagram<span class="sr-only"> (nouvel onglet)</span></a></li>
        <li><a href={boutique.reseaux.tiktok} rel="noopener" target="_blank">TikTok<span class="sr-only"> (nouvel onglet)</span></a></li>
      </ul>
    </div>
  </div>
  <div class="footer__bottom">
    <a href="/mentions-legales/">Mentions légales</a>
    <span>Aucun cookie, aucun suivi.</span>
    <span class="footer__createur">
      <a class="footer__credit" href={`mailto:${boutique.createur.email}`}>Site créé par {boutique.createur.nom}</a>
      <a class="footer__credit" href={boutique.createur.linkedin} rel="noopener" target="_blank">LinkedIn<span class="sr-only"> de {boutique.createur.nom} (nouvel onglet)</span></a>
    </span>
  </div>
</footer>
