---
// Image WebP responsive (srcset) à partir du nom de photo (voir assets/photos).
import { photo } from '../lib/site.js';
interface Props { name: string | null; alt: string; sizes?: string; eager?: boolean; class?: string; }
const { name, alt, sizes = '(min-width: 900px) 33vw, 90vw', eager = false, class: cls } = Astro.props;
const p = photo(name);
const big = p?.sizes.at(-1);
---
{p ? (
  <img
    class={cls}
    src={p.sizes[0].src}
    srcset={p.sizes.map((s) => `${s.src} ${s.w}w`).join(', ')}
    sizes={sizes}
    width={big.w}
    height={big.h}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'sync' : 'async'}
    fetchpriority={eager ? 'high' : undefined}
  />
) : (
  <span class:list={['img-manquante', cls]} role="img" aria-label={alt}>Photo à venir</span>
)}
